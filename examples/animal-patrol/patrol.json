{
  "agent_definition_schema_version": "2026-09-09.r1",
  "inputs": [
    {"type": "text", "text": "Inspect this Animal Patrol photo. Return only visible animals with counts, confidence from 0 to 1, and an optional note. Use null when no note is needed. Do not invent animals."},
    {"type": "image", "path": "assets/patrol.png"}
  ],
  "agent_schema": {
    "type": "object",
    "properties": {
      "location": {"type": "string"},
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "animal": {"type": "string", "enum": ["deer", "fox", "rabbit"]},
            "count": {"type": "integer", "minimum": 1},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "note": {"type": ["string", "null"]}
          }
        }
      }
    }
  },
  "actions": [{
    "name": "record_findings",
    "logic": {"==": [1, 1]},
    "run": [{
      "kind": "tool",
      "name": "csv_writer",
      "params": {"findings": {"var": "findings"}, "location": {"var": "location"}}
    }]
  }]
}
