        "run": [
          {
            "kind": "generate_image",
            "prompt": "An illustration.",
            "path": "./image.png",
            "reference_images": [
              {
                "path": [
                  " "
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "expected": {
