{
  "name": "strict_trimmed_top_level_file_path",
  "definition": {
    "agent_definition_schema_version": "2026-09-09.r1",
    "inputs": [
      {
        "type": "file",
        "path": " ./report.pdf "
      }
    ],
    "agent_schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "integer"
        }
      }
    },
    "actions": [
      {
        "name": "print_answer",
        "logic": {
          "==": [
            {
              "var": "answer"
            },
            4
          ]
        },
        "run": [
          {
            "kind": "exec",
            "program": "echo",
            "args": [
              {
                "var": "answer"
              }
            ]
          }
        ]
      }
    ]
  },
  "expected": {
    "accepted": true
  }
}
