{
  "name": "strict_padded_image_path_part_reference",
  "definition": {
    "agent_definition_schema_version": "2026-09-09.r1",
    "inputs": [
      {
        "type": "text",
        "text": "Return answer as an integer."
      }
    ],
    "agent_schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "integer"
        },
        "image_path": {
          "type": "string"
        }
      }
    },
    "actions": [
      {
        "name": "print_answer",
        "logic": {
          "==": [
            {
              "var": "answer"
            },
            4
          ]
        },
        "run": [
          {
            "kind": "generate_image",
            "prompt": "An illustration.",
            "path": "./image.png",
            "reference_images": [
              {
                "path": [
                  {
                    "var": " image_path "
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "expected": {
    "accepted": true
  }
}
