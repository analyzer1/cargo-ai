    "inputs": [
      {
        "type": "text",
        "text": "Return answer as an integer."
      }
    ],
    "agent_schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "integer"
        }
      }
    },
    "actions": [
      {
        "name": "print_answer",
        "logic": {
          "==": [
            {
              "var": "answer"
            },
            4
          ]
        },
        "run": [
          {
            "kind": "agent",
            "artifact": "./child.json",
            "inputs": [
              {
                "type": "file",
                "path": [
                  "input.csv "
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "expected": {
    "accepted": false,
    "code": "invalid_value",
    "path": "$.actions[0].run[0].inputs[0].path"
  }
