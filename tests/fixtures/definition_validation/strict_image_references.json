{
  "name": "strict_image_references",
  "definition": {
    "agent_definition_schema_version": "2026-09-09.r1",
    "inputs": [
      {
        "name": "photo",
        "type": "image",
        "path": "./assets/photo.png"
      },
      {
        "type": "text",
        "text": "Return answer as an integer."
      }
    ],
    "agent_schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "integer"
        }
      }
    },
    "actions": [
      {
        "name": "print_answer",
        "logic": {
          "==": [
            {
              "var": "answer"
            },
            4
          ]
        },
        "run": [
          {
            "kind": "generate_image",
            "prompt": "Use the source photo.",
            "path": "./artifacts/output.png",
            "reference_images": [
              {
                "input": "photo"
              },
              {
                "path": "./assets/style.png"
              }
            ]
          }
        ]
      }
    ]
  },
  "expected": {
    "accepted": true
  }
}
