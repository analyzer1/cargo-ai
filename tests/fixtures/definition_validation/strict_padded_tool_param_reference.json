{
  "name": "strict_padded_tool_param_reference",
  "definition": {
    "agent_definition_schema_version": "2026-09-09.r1",
    "inputs": [
      {
        "type": "text",
        "text": "Return answer as an integer."
      }
    ],
    "agent_schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "integer"
        }
      }
    },
    "actions": [
      {
        "name": "print_answer",
        "logic": {
          "==": [
            {
              "var": "answer"
            },
            4
          ]
        },
        "run": [
          {
            "kind": "tool",
            "name": "record_result",
            "params": {
              "answer": {
                "var": " answer "
              }
            }
          }
        ]
      }
    ]
  },
  "expected": {
    "accepted": true
  }
}
