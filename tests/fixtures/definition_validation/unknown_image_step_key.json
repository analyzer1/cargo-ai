{
  "name": "unknown_image_step_key",
  "definition": {
    "agent_definition_schema_version": "2026-09-09.r1",
    "inputs": [
      {
        "type": "text",
        "text": "Return answer as an integer."
      }
    ],
    "agent_schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "integer"
        }
      }
    },
    "actions": [
      {
        "name": "print_answer",
        "logic": {
          "==": [
            {
              "var": "answer"
            },
            4
          ]
        },
        "run": [
          {
            "kind": "generate_image",
            "prompt": "An illustration.",
            "path": "./artifacts/image.png",
            "output_variable": "extra"
          }
        ]
      }
    ]
  },
  "expected": {
    "accepted": false,
    "code": "unknown_field",
    "path": "$.actions[0].run[0].output_variable"
  }
}
