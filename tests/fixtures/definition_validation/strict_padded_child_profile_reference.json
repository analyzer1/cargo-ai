{
  "name": "strict_padded_child_profile_reference",
  "definition": {
    "agent_definition_schema_version": "2026-09-09.r1",
    "inputs": [
      {
        "type": "text",
        "text": "Return answer as an integer."
      }
    ],
    "agent_schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "integer"
        },
        "profile_name": {
          "type": "string"
        }
      }
    },
    "actions": [
      {
        "name": "print_answer",
        "logic": {
          "==": [
            {
              "var": "answer"
            },
            4
          ]
        },
        "run": [
          {
            "kind": "agent",
            "artifact": "./child.json",
            "profile": {
              "var": " profile_name "
            }
          }
        ]
      }
    ]
  },
  "expected": {
    "accepted": true
  }
}
