{
  "name": "unsupported_schema_remote_ref",
  "definition": {
    "agent_definition_schema_version": "2026-09-09.r1",
    "inputs": [
      {
        "type": "text",
        "text": "Return answer as an integer."
      }
    ],
    "agent_schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "integer",
          "$ref": "https://example.invalid/schema.json"
        }
      }
    },
    "actions": [
      {
        "name": "print_answer",
        "logic": {
          "==": [
            {
              "var": "answer"
            },
            4
          ]
        },
        "run": [
          {
            "kind": "exec",
            "program": "echo",
            "args": [
              {
                "var": "answer"
              }
            ]
          }
        ]
      }
    ]
  },
  "expected": {
    "accepted": false,
    "code": "unsupported_schema_keyword",
    "path": "$.agent_schema.properties.answer[\"$ref\"]"
  }
