{
  "agent_definition_schema_version": "2026-09-09.r1",
  "inputs": [
    {
      "type": "text",
      "text": "What is 2 + 2? Return the answer as a number."
    }
  ],
  "agent_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "integer",
        "description": "The result of the math problem."
      }
    }
  },
  "actions": [
    {
      "name": "is_4",
      "logic": {
        "==": [ { "var": "answer" }, 4 ]
      },
      "run": [
        {
          "platform": ["macos", "linux"],
          "kind": "exec",
          "program": "echo",
          "args": ["Value return is equal to", { "var": "answer" }]
        },
        {
          "platform": "windows",
          "kind": "exec",
          "program": "cmd",
          "args": ["/C", "echo", "Value return is equal to", { "var": "answer" }]
        }
      ]
    },
    {
      "name": "is_not_4",
      "logic": {
        "!=": [ { "var": "answer" }, 4 ]
      },
      "run": [
        {
          "kind": "exec",
          "program": "echo",
          "args": ["Value return is not equal to 4."]
        }
      ]
    }
  ]
}
