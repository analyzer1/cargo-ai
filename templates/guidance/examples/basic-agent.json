{
  "agent_definition_schema_version": "2026-09-09.r1",
  "inputs": [
    {
      "type": "text",
      "text": "What is 2 + 2? Return the answer as a number."
    }
  ],
  "agent_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "integer",
        "description": "The numeric result."
      }
    }
  },
  "actions": [
    {
      "name": "answer_is_4",
      "logic": {
        "==": [
          { "var": "answer" },
          4
        ]
      },
      "run": [
        {
          "kind": "email_me",
          "subject": "Agent produced the expected answer",
          "text": "The answer was 4."
        }
      ]
    }
  ]
}
