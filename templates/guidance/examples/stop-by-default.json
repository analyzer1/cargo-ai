{
  "agent_definition_schema_version": "2026-09-09.r1",
  "inputs": [
    {
      "type": "text",
      "text": "Should I build the report?"
    }
  ],
  "agent_schema": {
    "type": "object",
    "properties": {
      "build_report": {
        "type": "boolean"
      }
    }
  },
  "actions": [
    {
      "name": "build_report_flow",
      "logic": {
        "==": [{ "var": "build_report" }, true]
      },
      "run": [
        {
          "kind": "exec",
          "program": "this-command-should-not-exist",
          "args": [],
          "status_variable": "report_status",
          "error_variable": "report_error"
        },
        {
          "kind": "email_me",
          "subject": "Report ready",
          "text": [
            "This step only runs if the earlier exec succeeds."
          ]
        }
      ]
    }
  ]
}
